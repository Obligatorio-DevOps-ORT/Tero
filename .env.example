# Copiar este archivo como .env y completar los valores:
#   cp .env.example .env

# Contraseña de PostgreSQL (la usan db, catalog, carts, orders y admin)
DB_PASSWORD=

# Credenciales del panel de administración
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Clave con la que admin firma los tokens de sesión (JWT)
ADMIN_JWT_SECRET=